{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "New Jurisdiction proposal",
	"description": "Structured reasoning and provenance for one proposed change.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"title",
		"status",
		"problem",
		"objective",
		"assumptions",
		"normativeChoices",
		"proposedChange",
		"affectedProvisions",
		"affectedInterests",
		"dependencies",
		"tradeoffs",
		"strongestObjection",
		"failureModes",
		"testCases",
		"sources",
		"uncertainty",
		"authorship"
	],
	"properties": {
		"schemaVersion": {
			"const": "0.1"
		},
		"id": {
			"type": "string",
			"pattern": "^NJ-P-[0-9]{4}$"
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"status": {
			"type": "string",
			"enum": [
				"draft",
				"proposed",
				"under_review",
				"accepted",
				"rejected",
				"withdrawn",
				"superseded"
			]
		},
		"problem": {
			"type": "string",
			"minLength": 1
		},
		"objective": {
			"type": "string",
			"minLength": 1
		},
		"assumptions": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"normativeChoices": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"proposedChange": {
			"type": "string",
			"minLength": 1
		},
		"affectedProvisions": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^(CHARTER\\.md|GOVERNANCE\\.md|law/[A-Za-z0-9._/-]+)$"
			},
			"uniqueItems": true
		},
		"affectedInterests": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"dependencies": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"kind",
					"reference",
					"note"
				],
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"provision",
							"proposal",
							"external"
						]
					},
					"reference": {
						"type": "string",
						"minLength": 1
					},
					"note": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"uniqueItems": true
		},
		"tradeoffs": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"strongestObjection": {
			"type": "string",
			"minLength": 1
		},
		"failureModes": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"testCases": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^cases/NJ-C-[0-9]{4}\\.md$"
			},
			"uniqueItems": true
		},
		"sources": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"title",
					"locator",
					"supports"
				],
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1
					},
					"locator": {
						"type": "string",
						"minLength": 1
					},
					"supports": {
						"type": "string",
						"minLength": 1
					},
					"accessedOn": {
						"type": "string",
						"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
					}
				}
			},
			"uniqueItems": true
		},
		"uncertainty": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"authorship": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"mode",
				"aiSystems",
				"humanIntervention"
			],
			"properties": {
				"mode": {
					"type": "string",
					"enum": [
						"human_authored",
						"human_authored_ai_assisted",
						"agent_drafted_human_reviewed",
						"agent_authored",
						"multi_agent"
					]
				},
				"aiSystems": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"humanIntervention": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
